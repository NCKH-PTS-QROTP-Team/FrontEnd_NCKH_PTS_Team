{
  "name": "otp-attendance-system",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:web": "npx expo export -p web && node scripts/patch-dist-html.js",
    "build:web:fast": "NODE_ENV=production npx expo export -p web --clear && node scripts/patch-dist-html.js",
    "serve:dist": "node scripts/serve-dist.js"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "expo": "~54.0.32",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.21",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "postcss": "^8.5.6",
    "react-native-css-transformer": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
