{
  "expo": {
    "name": "OTP & Điểm Danh",
    "slug": "otp-attendance-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nckh.otpattendance",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép truy cập camera để quét QR code"
        }
      ]
    ],
    "scheme": "otp-attendance",
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7abc605e-cdbb-473d-a010-1f9bd3ba60ab"
      }
    }
  }
}
